{
  "name": "freevpn",
  "version": "0.2.0",
  "description": "FreeVPN — a Windows desktop client for the free public VPN Gate network, driving OpenVPN Community under the hood.",
  "main": "dist/main/main.js",
  "author": "tohidmalik002 (https://github.com/tohidmalik002)",
  "license": "GPL-2.0",
  "homepage": "https://github.com/tohidmalik002/FreeVPN#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/tohidmalik002/FreeVPN.git"
  },
  "bugs": {
    "url": "https://github.com/tohidmalik002/FreeVPN/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-assets.js",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "icon": "node scripts/gen-icon.js",
    "dist:win": "npm run build && npm run icon && electron-builder --win",
    "dist:linux": "npm run build && npm run icon && electron-builder --linux deb",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.freevpn.app",
    "productName": "FreeVPN",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts"
      }
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": "x64"
        }
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "executableName": "freevpn"
    },
    "deb": {
      "depends": [
        "openvpn",
        "policykit-1"
      ],
      "maintainer": "tohidmalik002 <noreply@users.noreply.github.com>"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        },
        {
          "target": "zip",
          "arch": "x64"
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FreeVPN"
    }
  }
}
